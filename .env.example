# ── Environment ────────────────────────────────────────────────────────────────
# "local"      → WebSocket served by this server (ngrok / Railway / self-hosted)
# "production" → WebSocket routed through Pipecat Cloud (requires AGENT_NAME + ORGANIZATION_NAME)
ENV=local

# ── Pipecat Cloud (only needed when ENV=production) ────────────────────────────
AGENT_NAME=
ORGANIZATION_NAME=

# ── Database ───────────────────────────────────────────────────────────────────
DB=goodwinds
DB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ── AI / Speech APIs ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
SARVAM_API_KEY=

# ── Plivo ──────────────────────────────────────────────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_NUMBER=+91XXXXXXXXXX

# ── Call Forwarding ────────────────────────────────────────────────────────────
FORWARD_TO_NUMBER=+91XXXXXXXXXX

# ── Zoho Order API ─────────────────────────────────────────────────────────────
ZOHO_ORDER_API_URL=https://www.zohoapis.in/creator/custom/<org>/<function>
ZOHO_API_PUBLIC_KEY=

# ── Seed Credentials (set before first boot to override defaults) ───────────────
ADMIN_PASSWORD=changeme
DEMO_USER_EMAIL=demouser@gmail.com
DEMO_USER_PASSWORD=changeme

# ── Frontend (only set when frontend is hosted separately from the API) ─────────
# VITE_BACKEND_URL=https://your-api-domain.com
